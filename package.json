    "@types/yauzl": "3.4.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@vitejs/plugin-react": "6.3.0",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.18",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "saxes": "6.0.0",
    "uplot": "1.6.32",
