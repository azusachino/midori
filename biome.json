{
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    },
    "domains": {
      "react": "none"
    }
  },
  "overrides": [
    {
      "includes": ["web/src/**"],
      "linter": {
        "domains": {
          "react": "all"
        }
      }
    }
  ],
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.cts",
      "**/*.mts",
      "**/*.json",
      "!bun.lock",
      "!node_modules",
      "!dist",
      "!site"
    ]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  }
}
